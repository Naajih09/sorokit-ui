{
  "name": "@sorokit/ui",
  "version": "0.0.1",
  "description": "Tailwind CSS React components for Soroban dApp interfaces.",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "stellar",
    "soroban",
    "react",
    "ui-kit"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@sorokit/core": "^0.0.1",
    "react": "^18.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "tailwindcss": "^3.4.3",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
